    - target: {fileID: 8881028038475493880, guid: fd28f23af44f73f4a95e33435872ad15, type: 3}
      propertyPath: m_Text
      value: "El Aspergillus es un g\xE9nero de hongos filamentosos (moho) extremadamente
        com\xFAn que vive en el suelo, materia vegetal en descomposici\xF3n y polvo
        dom\xE9stico. Se reproduce liberando miles de esporas microsc\xF3picas al
        aire y es conocido por formar esas colonias de aspecto polvoriento (verdes,
        blancas o negras) que a menudo vemos sobre el pan viejo o en paredes con
        humedad."
      objectReference: {fileID: 0}
